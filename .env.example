# Copy to .env and fill in. Everything works with no .env (mock calendar + free property APIs).

PORT=8787

# ---- Calendar ----
# mock   = local JSON calendar (server/data/mock-calendar.json), no Google account needed
# google = real Google Calendar via a service account
CALENDAR_MODE=mock

# Business rules (times are in BUSINESS_TZ)
BUSINESS_TZ=America/Los_Angeles
# 1=Mon ... 7=Sun
BUSINESS_DAYS=1,2,3,4,5,6
BUSINESS_START=08:00
BUSINESS_END=18:00
SLOT_STEP_MIN=30
TRAVEL_BUFFER_MIN=30
MIN_NOTICE_HOURS=24
BOOKING_HORIZON_DAYS=60

# Google mode only:
# 1) Create a service account in Google Cloud, enable "Google Calendar API", download its JSON key.
# 2) In Google Calendar (test account) > Settings > your calendar > "Share with specific people",
#    add the service account email with "Make changes to events".
GOOGLE_CALENDAR_ID=your-test-account@gmail.com
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
# ...or paste the whole JSON on one line instead of using a file:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Property lookup ----
# Optional: Rentcast free tier (~50 req/month) adds beds/baths/sqft/year built.
# Get a key at https://app.rentcast.io/app/api
RENTCAST_API_KEY=your_rentcast_api_key_here

# Contact string sent in the User-Agent to OpenStreetMap services (their usage policy requires it)
OSM_CONTACT=hiscorp@gmail.com
